{
  "extends": "./.nuxt/tsconfig.json",
  "exclude": [
    "dist",
    "node_modules",
    "playground",
  ],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noImplicitThis": true,
    "strict": true,
  },
}
