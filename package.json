{
  "name": "@xarenas107/nuxt-socket-io",
  "author": {
    "name": "Xavier Arenas",
    "email": "xarenas107@gmail.com"
  },
  "private": false,
  "version": "4.0.1",
  "description": "Nuxt module for socket.io",
  "keywords": [
    "websocket",
    "socket.io",
    "nuxt",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xarenas107/nuxt-socket.io"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "nuxt-module-build prepare",
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release:pre": "npm run lint && npm run test && npm run prepack && changelogen --release",
    "release": "npm run release:pre && npm publish --access public && git push --follow-tags",
    "lint": "eslint . --fix",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "cookie": "^2.0.2",
    "defu": "^6.1.7",
    "engine.io": "^6.6.13",
    "nitro": "^3.0.261103-rc",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/kit": "^4.7.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.7.0",
    "@nuxt/test-utils": "^4.4.0",
    "@pinia/nuxt": "^1.0.3",
    "@types/node": "^26.6.11",
    "changelogen": "^0.6.2",
    "crossws": "^0.4.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "nuxt": "^4.7.0",
    "pinia": "^4.1.0",
    "unbuild": "^3.6.1",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.25.8": true,
    "esbuild@0.25.5": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true,
    "@parcel/watcher@2.5.1": true
  }
}
